# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key (or Demo Key)
VITE_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_PLATFORM_KEY=

# Phase 4 Feature Flags (default false)
QUERY_UNDERSTANDING_ENABLED=false
QUERY_UNDERSTANDING_AI_ENABLED=false


# ---- Mobler 2.0 ----
# Required in production. Signs customer and shop sessions.
JWT_SECRET=
# Backend port and allowed front-end origins (comma separated). Empty = allow all (dev).
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# How long one booking holds a table, and the shops' timezone.
BOOKING_SLOT_DURATION_MIN=120
SHOP_TIMEZONE=Asia/Ho_Chi_Minh
# Front-end apps: API base URL when the API is on another domain (empty = same origin / dev proxy).
VITE_API_URL=

# ---- Mobler 2.0 backend ----
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Comma-separated origins of the customer & shop apps when hosted separately
CORS_ORIGINS=
SHOP_TIMEZONE=Asia/Ho_Chi_Minh
BOOKING_SLOT_DURATION_MIN=120
# Front-end builds: API base URL when apps are not served behind the same /api proxy
VITE_API_URL=

# ---- Locality data (xem docs/LOCALITY.md) ----
LOCALITY_MIN_PHOTOS=3
LOCALITY_MIN_REVIEWS=10
LOCALITY_SOURCES=osm,file_import          # dev mặc định thêm mock_dev
LOCALITY_DEV_MOCK=true                    # chỉ có tác dụng khi NODE_ENV != production
LOCALITY_OSM_ENABLED=true
LOCALITY_IMPORT_DIR=                      # thư mục GPM Automate xuất tệp mobler-locality-import/v1
LOCALITY_ALLOW_GOOGLE_FALLBACK=true
LOCALITY_CELL_FRESH_DAYS=30
LOCALITY_REQUEST_COOLDOWN_HOURS=24
LOCALITY_SOURCE_DAILY_LIMIT=200
LOCALITY_WORKER_ENABLED=true
LOCALITY_WORKER_CONCURRENCY=1
# Quán minh họa khi Google lỗi: mặc định tắt ở production, luôn gắn nhãn "minh họa"
SYNTHETIC_FALLBACK_PLACES=
# Connector GPM trực tiếp — khóa cho đến khi có tài liệu API + quyền dữ liệu (chỉ đặt trên server)
GPM_CONNECTOR_ENABLED=false
GPM_API_URL=
GPM_API_KEY=
# URL công khai của API (cho link ảnh proxy khi app chạy ở domain khác)
PUBLIC_API_URL=

# --- Free café data (OpenStreetMap / Overpass, no key needed) ---
# Optional: comma-separated Overpass mirrors to try in order.
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# OVERPASS_USER_AGENT=Mobler/2.0 (cafe finder; contact: you@example.com)
